{
  "name": "Gageabu API",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "api",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "overrideCommand": false,
  "shutdownAction": "none",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-dotnettools.csdevkit"
      ]
    }
  },

  // 매 시작 시: Windows에서 체크아웃한 레포를 리눅스 git이 다룰 수 있게 설정
  //  - safe.directory: 소유자가 달라서 나는 'dubious ownership' 오류 방지
  //  - autocrlf=input: Windows(CRLF) 작업본이 전부 '수정됨'으로 보이는 문제 방지
  "postStartCommand": "git config --global --add safe.directory /workspace && git config --global core.autocrlf input"
}
