# 운영 서버에서 .env.prod로 복사해 채운다. .env.prod는 Git에 올리지 않는다 (.gitignore)
# 무작위 값 만들기 (Linux): openssl rand -base64 48

# API 주소로 쓸 도메인. DNS A 레코드가 이 서버 IP를 가리켜야 HTTPS 인증서가 발급된다
GAGEBU_DOMAIN=api.example.com

# DB 비밀번호. 볼륨을 처음 만들 때 적용되므로 나중에 바꾸려면 docs/DEPLOY.md 참고
POSTGRES_PASSWORD=

# 로그인 토큰 서명 키 (32자 이상). 바꾸면 모든 사용자가 다시 로그인해야 한다
GAGEBU_JWT_KEY=

# (선택) 브라우저에서 API를 부를 웹 주소. 폰 앱만 쓰면 비워 둔다
GAGEBU_WEB_ORIGIN=
